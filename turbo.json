{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT"]
    },
    "clean": {
      "cache": false
    },
    "lint": {},
    "test": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "PORT",
        "E2E_BROWSER_CHANNEL",
        "E2E_SUPABASE",
        "E2E_MAILPIT_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "GITHUB_ACTIONS"
      ]
    }
  }
}
