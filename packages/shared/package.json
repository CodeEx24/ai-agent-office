{
  "name": "@ago/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client-env": {
      "types": "./dist/env/client-entry.d.ts",
      "default": "./dist/env/client-entry.js"
    },
    "./agent-limits": {
      "types": "./dist/agents/agent-limits.d.ts",
      "default": "./dist/agents/agent-limits.js"
    },
    "./agent-templates": {
      "types": "./dist/agents/agent-templates.d.ts",
      "default": "./dist/agents/agent-templates.js"
    },
    "./trifecta-lint": {
      "types": "./dist/agents/trifecta-lint.d.ts",
      "default": "./dist/agents/trifecta-lint.js"
    },
    "./skill-limits": {
      "types": "./dist/skills/skill-limits.d.ts",
      "default": "./dist/skills/skill-limits.js"
    },
    "./skills": {
      "types": "./dist/skills/skill-schemas.d.ts",
      "default": "./dist/skills/skill-schemas.js"
    },
    "./redaction": {
      "types": "./dist/redaction/index.d.ts",
      "default": "./dist/redaction/index.js"
    },
    "./pack-export": {
      "types": "./dist/packs/agent-pack-export.d.ts",
      "default": "./dist/packs/agent-pack-export.js"
    },
    "./agent-pack.schema.json": "./schemas/agent-pack.v1.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "pack:schema": "tsc -p tsconfig.build.json && node tools/generate-agent-pack-schema.mjs",
    "pack:schema:check": "tsc -p tsconfig.build.json && node tools/generate-agent-pack-schema.mjs --check",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0"
  }
}
