{
  "name": "agent-office",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Office: AI agents working in a shared 3D virtual office with shared Markdown memory.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration:new": "supabase migration new",
    "db:types": "node scripts/db-types.mjs"
  },
  "devDependencies": {
    "supabase": "3.0.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3"
  }
}
