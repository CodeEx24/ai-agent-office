# Agent Office environment variables (AGO-70).
# Copy to .env.local and fill in. NEVER commit .env or .env.local (git-ignored).
# Source of truth: packages/shared/src/env/schema.ts. Docs: docs/environments.md.
# Rule: only NEXT_PUBLIC_* variables may reach the browser. Everything else is server-only.
# `pnpm build` fails if a secret reaches the client bundle. Values are safe placeholders.

# local | preview | production. Defaults to local when unset.
# Preview and production REQUIRE the Supabase keys and DATABASE_URL and https URLs.
APP_ENV=local
# Trust X-Forwarded-For for rate limits only behind a proxy that overwrites it (set true on Vercel).
TRUST_PROXY_HEADERS=false

# --- Public (NEXT_PUBLIC_*): bundled into the browser, never put secrets here ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local Supabase ports are reserved as 44320-44329 (see AGO-78).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
# Anon (publishable) key; public by design, RLS protects data. Run `supabase status` locally. Required in preview/production.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# --- Server-only: never exposed to the client ---
SUPABASE_URL=http://127.0.0.1:44321
# Bypasses RLS. Server only. Required in preview/production.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# Postgres connection string for worker and pg-boss. Required in preview/production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:44322/postgres
# Server-only. Signs per-run agent credentials (AGO-148). At least 32 chars. REQUIRED when APP_ENV is preview or production (openssl rand -base64 48).
# Leave empty locally: a dev-only default is used.
AGENT_CREDENTIAL_SIGNING_SECRET=
# Optional until used:
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
